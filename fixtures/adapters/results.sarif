{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ExampleScan",
          "semanticVersion": "1.4.2",
          "rules": [
            { "id": "EX001", "shortDescription": { "text": "Hard-coded credential" }, "defaultConfiguration": { "level": "error" } },
            { "id": "EX002", "shortDescription": { "text": "Unused variable" }, "defaultConfiguration": { "level": "note" } },
            { "id": "EX003", "shortDescription": { "text": "Unchecked return value" } }
          ]
        }
      },
      "results": [
        { "ruleId": "EX001", "level": "error", "message": { "text": "Possible hard-coded password in `config.rs`." }, "locations": [ { "physicalLocation": { "artifactLocation": { "uri": "src/config.rs" }, "region": { "startLine": 42 } } } ] },
        { "ruleId": "EX003", "level": "warning", "message": { "text": "The result of `write` is ignored." }, "locations": [ { "physicalLocation": { "artifactLocation": { "uri": "src/io.rs" }, "region": { "startLine": 118, "startColumn": 5 } } } ] },
        { "ruleId": "EX003", "message": { "text": "The result of `flush` is ignored." }, "locations": [ { "physicalLocation": { "artifactLocation": { "uri": "src/io.rs" }, "region": { "startLine": 131 } } } ] },
        { "ruleId": "EX002", "message": { "text": "Variable `tmp` is never read." }, "locations": [ { "physicalLocation": { "artifactLocation": { "uri": "src/main.rs" }, "region": { "startLine": 9 } } } ] }
      ]
    }
  ]
}
