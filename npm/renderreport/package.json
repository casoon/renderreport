{
  "name": "@casoon/renderreport",
  "version": "0.7.3",
  "description": "Multi-page PDF reports from components and data, rendered by Typst as an embedded engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casoon/renderreport.git",
